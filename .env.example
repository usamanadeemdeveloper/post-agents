# ─── App ───────────────────────────────────────────────────────────────────────
# Get free NewsAPI key at newsapi.org (100 requests/day — more than enough)
NEWSAPI_KEY=your_newsapi_key


NODE_ENV=development
PORT=3000

# ─── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ─── LinkedIn ──────────────────────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx   # or urn:li:organization:xxxxxxxx for a company page

# ─── Twitter / X ───────────────────────────────────────────────────────────────
TWITTER_APP_KEY=your_twitter_app_key
TWITTER_APP_SECRET=your_twitter_app_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# NewsAPI
NEWSAPI_KEY=

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Cron expression — default: every 3 days at 9:00 AM UTC
CRON_SCHEDULE=0 9 */3 * *
