# ─── Core App ────────────────────────────────────────────────────────────────
# Local defaults. In GitHub Actions, NODE_ENV is already set to production.
NODE_ENV=development
PORT=3000

# ─── Required In Production ──────────────────────────────────────────────────
# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Keep this set in GitHub Secrets as well (workflow reads it explicitly)
CLAUDE_MODEL=claude-sonnet-4-6

# LinkedIn publishing
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx
# or: urn:li:organization:xxxxxxxx (company page posting)

# ─── Optional In Production ──────────────────────────────────────────────────
# News source boost (newsapi.org free tier)
NEWSAPI_KEY=

# Twitter/X posting (leave empty to disable Twitter posting)
TWITTER_APP_KEY=
TWITTER_APP_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Cron expression (default: every 3 days at 09:00 UTC)
CRON_SCHEDULE=0 9 */3 * *

# Optional: override story variation seed (workflow sets this automatically)
POST_VARIATION_SEED=

# Optional: posted-story history path (relative to repo root)
POST_HISTORY_FILE=.post-history.json

# Optional: generated-content dedup similarity threshold (0.0 - 1.0)
# Higher = stricter duplicate blocking. Recommended: 0.78 - 0.82
CONTENT_SIMILARITY_THRESHOLD=0.80

# ─── Prompt Settings (Optional) ──────────────────────────────────────────────
# default | technical | marketing | casual
POSTING_STYLE=default
DEFAULT_TONE=
PROMPT_VERSION=
